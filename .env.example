# Server-side environment variables (never exposed to the frontend)

# AI provider key used by src/lib/ai.server.ts
LOVABLE_API_KEY=
# Optional fallback if you bring your own key
OPENAI_API_KEY=

# Frontend API base URL (optional, defaults to same-origin /api)
VITE_API_URL=/api

# Supabase Auth (PUBLIC credentials only — never put the service_role key here)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
